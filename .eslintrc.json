{
  "extends": "next/core-web-vitals",
  "overrides": [
    {
      // Root config files (e.g. tailwind.config.ts) are loaded by tools that
      // don't resolve tsconfig paths, so they keep relative imports.
      "files": ["src/**/*", "sanity/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["./*", "../*"],
                "message": "Use the @/ path aliases instead of relative imports."
              }
            ]
          }
        ]
      }
    }
  ]
}
